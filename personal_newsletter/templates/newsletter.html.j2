<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ newsletter.subject }}</title>
</head>
<body style="margin:0; padding:0; background-color:#f5f3ee; font-family: Georgia, 'Times New Roman', serif; color:#2b2b2b;">
  <div style="max-width:640px; margin:0 auto; padding:32px 20px;">
    <div style="background:#ffffff; border:1px solid #e3ded3; border-radius:8px; padding:36px 40px;">

      <p style="font-size:12px; letter-spacing:2px; text-transform:uppercase; color:#a08a5f; margin:0 0 20px 0;">
        Your personal newsletter &middot; {{ date }}
      </p>

      <h1 style="font-size:26px; line-height:1.3; margin:0 0 16px 0;">{{ newsletter.subject }}</h1>

      <p style="font-size:16px; line-height:1.6; margin:0 0 8px 0;">{{ newsletter.greeting }}</p>
      <p style="font-size:16px; line-height:1.6; margin:0 0 28px 0;">{{ newsletter.intro }}</p>

      {% for section in newsletter.sections %}
      <h2 style="font-size:14px; letter-spacing:1.5px; text-transform:uppercase; color:#a08a5f; border-bottom:1px solid #e3ded3; padding-bottom:6px; margin:28px 0 16px 0;">
        {{ section.heading }}
      </h2>
        {% for item in section.items %}
        <div style="margin:0 0 22px 0;">
          <a href="{{ item.url }}" style="font-size:18px; color:#1f3a5f; text-decoration:none; font-weight:bold;">{{ item.title }}</a>
          <p style="font-size:12px; color:#8a8a8a; margin:4px 0 6px 0;">{{ item.source }}</p>
          <p style="font-size:15px; line-height:1.6; margin:0 0 6px 0;">{{ item.summary }}</p>
          <p style="font-size:14px; line-height:1.5; margin:0; color:#5c5346;"><em>Why it matters: {{ item.why_it_matters }}</em></p>
        </div>
        {% endfor %}
      {% endfor %}

      <p style="font-size:16px; line-height:1.6; margin:28px 0 0 0;">{{ newsletter.sign_off }}</p>
    </div>

    <p style="font-size:12px; color:#9a9284; text-align:center; margin:20px 0 0 0;">
      Curated just for {{ subscriber.name }} based on: {{ subscriber.topics | join(', ') }}
    </p>
  </div>
</body>
</html>
